{
  "name": "devcollab-root",
  "version": "0.1.0",
  "private": true,
  "description": "DevCollab - Developer Collaboration Platform Workspace",
  "repository": {
    "type": "git",
    "url": "https://github.com/PANKAJ-YADAV-21/DevCollab.git"
  },
  "homepage": "https://github.com/PANKAJ-YADAV-21/DevCollab#readme",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
